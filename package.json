{
  "name": "doji",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "clean": "find . -type d \\( -name '.turbo' -o -name '.next' -o -name 'dist' -o -name 'build' -o -name 'dev-dist' -o -name '.next-docs' \\) ! -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null; true",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev --filter=web",
    "dev:server": "turbo run dev --filter=server",
    "dev:docs": "turbo run dev --filter=docs",
    "db:push": "turbo run db:push --filter=@doji/db",
    "db:seed-referral": "turbo run db:seed-referral --filter=@doji/db",
    "db:studio": "turbo run db:studio --filter=@doji/db",
    "db:generate": "turbo run db:generate --filter=@doji/db",
    "db:migrate": "turbo run db:migrate --filter=@doji/db",
    "db:baseline": "turbo run db:baseline --filter=@doji/db",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip",
    "dup": "jscpd .",
    "flag-audit": "tsx scripts/flag-audit.ts",
    "react-doctor": "npx react-doctor@latest apps/web --verbose -y",
    "react-doctor:diff": "npx react-doctor@latest apps/web --verbose --diff main -y",
    "vercel:link": "turbo login && turbo link",
    "vercel:env:pull": "vercel env pull",
    "vercel:env:pull:web": "vercel env pull apps/web/.env.local --cwd apps/web",
    "vercel:env:pull:server": "vercel env pull apps/server/.env.local --cwd apps/server",
    "vercel:env:audit": "pnpm dlx tsx scripts/vercel-env-audit.ts",
    "ruler": "pnpm dlx @intellectronica/ruler apply --no-backup",
    "ruler:dry": "pnpm dlx @intellectronica/ruler apply --dry-run",
    "ruler:revert": "pnpm dlx @intellectronica/ruler revert",
    "skills:add": "pnpm dlx skills add",
    "skills:list": "pnpm dlx skills list",
    "skills:find": "pnpm dlx skills find",
    "skills:update": "pnpm dlx skills update",
    "skills:check": "pnpm dlx skills check",
    "skills:remove": "pnpm dlx skills remove"
  },
  "dependencies": {
    "@doji/env": "workspace:*",
    "dotenv": "catalog:",
    "tslib": "^2.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@doji/config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-orm": "^0.45.2",
    "fast-check": "^4.8.0",
    "jscpd": "^4.2.4",
    "jsdom": "^29.1.1",
    "knip": "^6.14.2",
    "lru-cache": "^11.5.1",
    "turbo": "^2.9.16",
    "typescript": "catalog:",
    "ultracite": "7.8.0",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "axios": "1.15.0",
      "viem": "2.50.4",
      "@types/react": "19.2.15",
      "@types/react-dom": "19.2.3",
      "@wagmi/connectors": "5.11.2"
    },
    "patchedDependencies": {},
    "onlyBuiltDependencies": [
      "@sentry-internal/node-cpu-profiler",
      "@sentry/cli",
      "bufferutil",
      "esbuild",
      "msw",
      "utf-8-validate"
    ]
  }
}
